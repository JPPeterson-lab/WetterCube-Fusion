    .header.cf = LV_IMG_CF_RGB565A8,
    .header.always_zero = 0,
    .header.reserved = 0,
    .header.w = 128,
    .header.h = 128,
    .data_size = 49152, /* RGB565 (32768) + Alpha (16384) */
#if LV_COLOR_16_SWAP == 0
    .data = sunset_rgb565a8_map,
#else
    .data = sunset_rgb565a8_swap_map,
#endif
#endif
};
