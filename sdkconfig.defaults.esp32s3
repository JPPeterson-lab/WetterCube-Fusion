# ── Ziel: Waveshare ESP32-S3-Touch-LCD-7B (16 MB Flash, 8 MB OPI-PSRAM) ──────────
CONFIG_IDF_TARGET="esp32s3"

# Flash und PSRAM muessen auf gleicher Frequenz laufen (aus den Projekten "zentralsteuerung" und DeckPad, dort erprobt)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y
# Code und Nur-Lese-Daten im PSRAM: Flash-Zugriffe (Update!) halten Programm und Display nicht mehr an
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# WLAN- und LWIP-Puffer bleiben im internen RAM (wie im flimmerfreien XL-Build): im PSRAM konkurrieren sie mit dem Bildspeicher um die Bandbreite und das Display flimmert
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set

# ── Display-Ansteuerung flash-sicher ────────────────────────────────────────────
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_GDMA_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# ── Cache und Compiler ─────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ── Interner RAM schonen (WLAN, TLS, LVGL-Zeichenpuffer und RGB-Bounce-Buffer teilen sich ihn) ──
# SPI-Treiber (Speicherkarte) nicht im IRAM halten: spart internen RAM (der Treiber muss nicht flash-sicher sein)
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set

# Groesseres TCP-Fenster (Datei-Upload der Firmware, Downloads): vorher 4 Segmente, damit nur ca. 5 KB/s bei WLAN-Latenz
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_WND_DEFAULT=23040
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

# ── WLAN-Puffer: sparsam im internen RAM (vorher kamen diese Werte aus der Arduino-Komponente) ──
# feste Empfangspuffer liegen im internen RAM (je 1,6 KB), dynamische Sende-/Empfangspuffer zuerst im PSRAM (siehe SPIRAM_TRY_ALLOCATE_WIFI_LWIP)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
# WLAN-Code im Flash statt im IRAM (spart ca. 15-20 KB internen RAM, kaum messbarer Geschwindigkeitsverlust), weniger feste Sendepuffer
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
